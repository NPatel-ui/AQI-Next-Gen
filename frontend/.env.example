# Local FastAPI backend (optional in development; Vite proxies /api automatically)
# For production, set this to your deployed API origin, e.g. https://your-api.example.com
VITE_API_URL=

# Supabase project settings are required for sign-up, sign-in, profile preferences and saved forecasts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
